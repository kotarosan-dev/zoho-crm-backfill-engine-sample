string standalone.bf_evaluateD1(String closingDateText, String stageText, String effectiveDateText, String currentFlagText, String currentDaysText)
{
// Backfill engine - rule D1 evaluator (standalone) DRAFT D1-v1, 2026-11-11 (Phase 2)
// Spec v0.2 sections 4, 13.3 and TC-11. Pure evaluation only: no API calls, no writes.
// Rule D1 (Deals, overdue re-flag):
//   input  = Closing_Date and Stage.
//   overdue = Closing_Date is before the effective date (the same day is NOT overdue)
//             and Stage is not in the fixed Closed list.
//   writes = BF_Overdue_Flag (checkbox) and BF_Overdue_Days (number = days past Closing_Date).
//   Two-way re-flag: a deal that is no longer overdue is cleared to false / 0 (counts as a change).
// Closed list = Closed Won / Closed Lost / Closed Lost to Competitor, confirmed against the real Stage
// values of the author's org on 2026-11-12 (the org spells it "Competitor"). Change it only together with
// the version label D1-v1.
// Arguments are primitive strings:
//   closingDateText   yyyy-MM-dd or "" (a longer ISO text is cut to its first 10 characters)
//   stageText         picklist value or ""
//   effectiveDateText yyyy-MM-dd (Run.Effective_Date)
//   currentFlagText   "true" / "false" / ""
//   currentDaysText   current BF_Overdue_Days or ""
// Return = the Map below, returned as its String form (result.toString()) because standalone functions
// return String only: a Map declaration was refused on save with "Invalid return Type Map. Category
// standalone returns string" (measured 2026-11-12, knowledge base 5.2).
// Callers must apply .toMap() to the returned text before reading the keys.
// Return Map keys (after .toMap()):
//   change  boolean, true when the target values differ from the current values
//   outcome "CHANGE" / "NOCHANGE" / "EXCLUDED"
//   writes  Map of field API name to value; an empty Map unless change is true
//   detail  short text for the ledger (Backfill_Logs Proposed_Detail)
// Empty Closing_Date: treated as "not overdue / clear side" (spec 13.3: null is excluded from the target and cleared).
// Invalid (unparseable) Closing_Date or effective date: EXCLUDED, nothing is written.
// An empty BF_Overdue_Days counts as 0, so never-flagged open deals are not rewritten with 0.
// Day difference uses the same method as bf_evaluateL1 / Runner v1.3 (toLong() / 86400000 then floor).
// Deluge constraints applied: no while, no C-style for, no ternary, comments on their own lines only.
// Related: standalone.bf_runnerCore (caller, v2.0), standalone.bf_evaluateL2 (same style).
	closedStages = {"Closed Won","Closed Lost","Closed Lost to Competitor"};
	result = Map();
	result.put("change",false);
	result.put("outcome","EXCLUDED");
	result.put("writes",Map());
	result.put("detail","");
	// Current values, normalised
	curFlag = false;
	if(currentFlagText != null)
	{
		if(currentFlagText.trim().toLowerCase() == "true")
		{
			curFlag = true;
		}
	}
	curDays = 0;
	curDaysText = "";
	if(currentDaysText != null)
	{
		curDaysText = currentDaysText.trim();
	}
	if(curDaysText != "")
	{
		try
		{
			curDays = curDaysText.toDecimal().toLong();
		}
		catch (eCur)
		{
			// Unreadable current value: force a rewrite
			curDays = -1;
		}
	}
	stage = "";
	if(stageText != null)
	{
		stage = stageText.trim();
	}
	// Effective date: must be a real yyyy-MM-dd date
	effText = "";
	if(effectiveDateText != null)
	{
		effText = effectiveDateText.trim();
	}
	if(effText.length() > 10)
	{
		effText = effText.subString(0,10);
	}
	effOk = false;
	effDate = "1970-01-01".toDate();
	if(effText.length() == 10)
	{
		try
		{
			effDate = effText.toDate();
			if(effDate != null)
			{
				if(effDate.toString("yyyy-MM-dd") == effText)
				{
					effOk = true;
				}
			}
		}
		catch (eEff)
		{
			effOk = false;
		}
	}
	if(effOk == false)
	{
		result.put("detail","EXCLUDED invalid effective date");
		return result.toString();
	}
	// Closing date
	closeText = "";
	if(closingDateText != null)
	{
		closeText = closingDateText.trim();
	}
	targetFlag = false;
	targetDays = 0;
	detailText = "";
	if(closeText == "")
	{
		detailText = "NOT OVERDUE no closing date";
	}
	else
	{
		if(closeText.length() > 10)
		{
			closeText = closeText.subString(0,10);
		}
		closeOk = false;
		closeDate = "1970-01-01".toDate();
		if(closeText.length() == 10)
		{
			try
			{
				closeDate = closeText.toDate();
				if(closeDate != null)
				{
					if(closeDate.toString("yyyy-MM-dd") == closeText)
					{
						closeOk = true;
					}
				}
			}
			catch (eClose)
			{
				closeOk = false;
			}
		}
		if(closeOk == false)
		{
			result.put("detail","EXCLUDED invalid closing date");
			return result.toString();
		}
		diffMs = effDate.toLong() - closeDate.toLong();
		days = (diffMs / 86400000).floor();
		daysLong = days.toLong();
		daysText = daysLong.toString();
		if(closedStages.contains(stage))
		{
			detailText = "NOT OVERDUE closed stage " + stage;
		}
		else if(daysLong > 0)
		{
			targetFlag = true;
			targetDays = daysLong;
			detailText = "OVERDUE " + daysText + "d since " + closeText;
		}
		else
		{
			detailText = "NOT OVERDUE closing " + closeText;
		}
	}
	changed = false;
	if(curFlag != targetFlag)
	{
		changed = true;
	}
	if(curDays != targetDays)
	{
		changed = true;
	}
	result.put("change",changed);
	if(changed == true)
	{
		writes = Map();
		writes.put("BF_Overdue_Flag",targetFlag);
		writes.put("BF_Overdue_Days",targetDays);
		result.put("writes",writes);
		result.put("outcome","CHANGE");
	}
	else
	{
		result.put("outcome","NOCHANGE");
	}
	result.put("detail",detailText);
	return result.toString();
}
